# Local env — never commit real keys
.env
.env.local

# CV service (Python). The pool holds ~10 live OpenAI keys, so its env file is
# the single most sensitive file in the repo — matched explicitly rather than
# relying on the bare `.env` rule above, which only covers the root.
cv-service/.env
cv-service/.venv/
cv-service/**/__pycache__/
cv-service/.pytest_cache/

# Voice auditions. Generated by `npm run voices:sample` to choose a voice;
# they are not part of the tour and should not ship to the CDN.
public/tour/audio/_sample-*.mp3
