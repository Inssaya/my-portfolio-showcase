# Copy to .env for local development. On Render, set these in the dashboard.

# Postgres connection string — Render provides this automatically when the
# database is linked to the web service via render.yaml.
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio"

# 32+ bytes of random hex, used to sign JWTs. Regenerate to invalidate every
# outstanding session at once. `openssl rand -hex 32` generates a good value.
JWT_SECRET="change-me-to-a-64-char-hex-string"

# Comma-separated origins allowed to hit the API from a browser. The Vercel
# production domain plus any preview domains you use. Use "*" only for local
# development — never in production.
FRONTEND_ORIGIN="http://localhost:8080,https://my-portfolio-three-tau-68.vercel.app"

# HTTP port. Render sets this automatically; only set it locally.
PORT="4000"

# Bootstrap admin credentials — read once by `npm run seed` to create the
# first user. Change the password from the admin UI after your first login,
# then feel free to remove these env vars.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-immediately-after-first-login"
