# Copy to cv-service/.env for local dev, and set these on the host
# (Render / Railway / Fly) for production.

# --- OpenAI keys -------------------------------------------------------------
# The service pools keys because OpenAI rate-limits per key, so one key caps how
# many people can build a CV at once. Give it several and it schedules across
# them, parking any key that returns 429 until OpenAI says it is ready again.
#
# Use EITHER shape, or both together — they are merged and de-duplicated.
#
# One variable, quick to paste:
OPENAI_API_KEYS=sk-proj-aaa,sk-proj-bbb,sk-proj-ccc
#
# Or one variable per key. Preferred with ~10 keys: rotating a single key does
# not mean re-pasting one enormous line and hoping no comma was lost.
# OPENAI_API_KEY_1=sk-proj-aaa
# OPENAI_API_KEY_2=sk-proj-bbb
# ... up to OPENAI_API_KEY_20

# Model. The draft lives in server state, so the model never holds or restates
# the whole document (see app/session.py) — that is what keeps requests small
# whichever model is used.
#
# Not a *small* model by default any more, though. A small one saved an
# uploaded template's "123 Anywhere St." and Lorem Ipsum job descriptions as
# if they were the visitor's own; judging that is what the larger model buys.
# gpt-4o-mini still works if cost matters more than judgement here.
LLM_MODEL=gpt-4o

# --- limits ------------------------------------------------------------------
# Two ceilings with deliberately different shapes, one per kind of visitor.
# Neither is a per-minute limit — that is RATE_LIMIT_ENABLED below.
#
# A GUEST (no account) is rationed per CONVERSATION. Their identity is free to
# mint, so a weekly figure keyed on it would measure nothing; what a
# per-conversation ceiling buys is a hard stop on one runaway session. 80k
# covers a full interview (~34.7k measured) and substantial revision after it.
GUEST_SESSION_TOKENS=80000

# AN ACCOUNT is rationed per rolling WEEK across every conversation, with no
# per-session ceiling at all — start as many CVs as you like, revise one as
# long as you need. 300k is roughly eight full interviews a week. Rolling, not
# calendar, so nobody is locked out until an arbitrary Monday.
#
# Read from the cv_usage ledger in Postgres, not from memory: a weekly window
# has to survive the restarts a single Render instance does routinely.
ACCOUNT_WEEKLY_TOKENS=300000

# Either accepts 0 to switch that ceiling off entirely.

# In-process rate limiting (app/ratelimit.py): a global per-IP backstop on
# every route, plus tighter limits on /chat, /upload and /generate, the three
# that spend real OpenAI tokens or real CPU. Those three ration signed-up
# users per account and guests per IP — a per-account limit means nothing to
# a caller who can mint a fresh anonymous account per request — and there is
# one more rule for guests only: how fast NEW conversations may be opened,
# without which the per-conversation ceiling above bounds nothing. On by
# default. This is the escape hatch — flip off with no redeploy if the limiter
# itself ever misbehaves, not a knob meant to be used routinely.
RATE_LIMIT_ENABLED=true

# --- auth ----------------------------------------------------------------
# The same Supabase project the portfolio's admin panel already uses — see
# src/lib/supabase.ts for the matching frontend values (VITE_SUPABASE_URL /
# VITE_SUPABASE_ANON_KEY). Only the anon key, never service_role: this service
# verifies a visitor's bearer token by asking Supabase's own /auth/v1/user
# endpoint, so it never touches the database directly and the service_role key
# has no reason to exist here. See app/auth.py for why.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...

# --- CORS --------------------------------------------------------------------
# Every origin allowed to call this service: the Vite dev server plus the
# deployed portfolio. No trailing slashes.
ALLOWED_ORIGINS=http://localhost:8080,https://yassine-sinif.vercel.app

# --- upload routing ----------------------------------------------------------
# An uploaded image is either the visitor's CV (photographed, scanned or
# screenshotted) or a portrait to print on it, and only the pixels tell them
# apart — so by default every image goes to vision, which reads it and decides.
#
# Set true to run a local ink/whitespace heuristic first and only pay for
# vision when it says "page of text". Pure cost lever, and measurably wrong on
# dark-theme and coloured-sidebar CVs (this service's own `modern` style among
# them): with it on, a screenshot of one is filed as the visitor's headshot and
# their CV is never read. Leave false unless vision spend is a real problem.
CHEAP_IMAGE_ROUTING=false
