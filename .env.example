# Copy to .env.local for local dev, and set these on Vercel for production
# (Project Settings → Environment Variables → Production + Preview).

# Supabase project — Settings → API in the Supabase dashboard.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co

# The "anon public" key. Safe to ship in the client bundle; Supabase enforces
# access via RLS policies on the database, not through key secrecy.
# NEVER put the service_role key here — that one bypasses RLS entirely.
VITE_SUPABASE_ANON_KEY=eyJhbGc...
