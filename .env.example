# Voice generation — one-time, run locally. See scripts/README.md.
OPENAI_API_KEY=
# Optional: pin a speech model instead of letting the script negotiate one.
TOUR_TTS_MODEL=
# Optional: alloy | onyx | nova | shimmer
TOUR_VOICE=onyx

# Portfolio assistant — set these in the Vercel project settings, not in a file.
# Without ASSISTANT_API_KEY the widget shows a friendly "not switched on" state
# instead of failing, so the site is always safe to deploy.
ASSISTANT_API_KEY=
# Any OpenAI-compatible endpoint. Groq: https://api.groq.com/openai/v1
ASSISTANT_BASE_URL=https://api.openai.com/v1
ASSISTANT_MODEL=gpt-4o-mini
